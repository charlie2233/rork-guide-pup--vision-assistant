# Copy these values into `.dev.vars` for local Wrangler development.

ENVIRONMENT=development
BOOTSTRAP_SIGNING_SECRET=change-me
OPENAI_API_KEY=change-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5
PROMPT_VERSION=2026-05-22.v1
RATE_LIMIT_PER_MINUTE=20
SESSION_TTL_SECONDS=86400

# Local dev can stay permissive, but staging and production must use explicit origins.
CORS_ORIGIN=*
CORS_ALLOWED_ORIGINS=

# Optional AI Gateway wiring.
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_AUTH_HEADER=authorization
AI_GATEWAY_AUTH_PREFIX=Bearer
AI_GATEWAY_PATH=/chat/completions
AI_GATEWAY_FALLBACK_BASE_URL=
AI_GATEWAY_FALLBACK_API_KEY=
AI_GATEWAY_FALLBACK_AUTH_HEADER=authorization
AI_GATEWAY_FALLBACK_AUTH_PREFIX=Bearer
AI_GATEWAY_FALLBACK_PATH=/chat/completions

# Experimental benchmark-only MiniCPM-o toggle.
EXPERIMENTAL_MINICPM_O_BENCHMARK=false
DEBUG_BENCHMARK_TOKEN=

# Optional observability.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_DIST=
