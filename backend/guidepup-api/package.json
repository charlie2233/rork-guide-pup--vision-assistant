{
  "name": "guidepup-api",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "wrangler deploy --dry-run --env production",
    "check:staging": "wrangler deploy --dry-run --env staging",
    "deploy": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "dev:production": "wrangler dev --env production",
    "dev:staging": "wrangler dev --env staging",
    "eval": "node eval/run-eval.mjs",
    "eval:json": "node eval/run-eval.mjs --format json",
    "eval:markdown": "node eval/run-eval.mjs --format markdown",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types src/env.d.ts"
  },
  "dependencies": {
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "wrangler": "^4.62.1"
  }
}
