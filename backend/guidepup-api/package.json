{
  "name": "guidepup-api",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/verify-required-secrets.mjs --env production && wrangler deploy --dry-run --env production",
    "check:staging": "node scripts/verify-required-secrets.mjs --env staging && wrangler deploy --dry-run --env staging",
    "deploy": "node scripts/verify-required-secrets.mjs --env production && wrangler deploy --env production",
    "deploy:staging": "node scripts/verify-required-secrets.mjs --env staging && wrangler deploy --env staging",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "dev:production": "wrangler dev --env production",
    "dev:staging": "wrangler dev --env staging",
    "eval": "node eval/run-eval.mjs",
    "eval:json": "node eval/run-eval.mjs --format json",
    "eval:markdown": "node eval/run-eval.mjs --format markdown",
    "smoke:production": "node eval/run-live-smoke.mjs --env production --output-json eval/smoke-results-production.latest.json --output-md eval/smoke-results-production.latest.md",
    "smoke:staging": "node eval/run-live-smoke.mjs --env staging --output-json eval/smoke-results-staging.latest.json --output-md eval/smoke-results-staging.latest.md",
    "test:privacy": "node --test test/*.test.mjs",
    "verify:secrets:production": "node scripts/verify-required-secrets.mjs --env production",
    "verify:secrets:staging": "node scripts/verify-required-secrets.mjs --env staging",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types src/env.d.ts"
  },
  "dependencies": {
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "wrangler": "^4.62.1"
  }
}
