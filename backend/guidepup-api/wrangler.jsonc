{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guidepup-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "AI_GATEWAY_BASE_URL": "",
    "AI_GATEWAY_AUTH_HEADER": "authorization",
    "AI_GATEWAY_AUTH_PREFIX": "Bearer ",
    "AI_GATEWAY_PATH": "/chat/completions",
    "AI_GATEWAY_FALLBACK_BASE_URL": "",
    "AI_GATEWAY_FALLBACK_AUTH_HEADER": "authorization",
    "AI_GATEWAY_FALLBACK_AUTH_PREFIX": "Bearer ",
    "AI_GATEWAY_FALLBACK_PATH": "/chat/completions",
    "ENVIRONMENT": "development",
    "VISION_PROVIDER": "openai-compatible",
    "EXPERIMENTAL_MINICPM_O_BENCHMARK": "false",
    "HUGGINGFACE_MINICPM_O_BASE_URL": "",
    "HUGGINGFACE_MINICPM_O_MODEL": "openbmb/MiniCPM-o-2_6",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_MODEL": "gpt-5.5",
    "OPENAI_REASONING_EFFORT": "low",
    "PROMPT_VERSION": "2026-05-22.v1",
    "SESSION_TTL_SECONDS": "86400",
    "RATE_LIMIT_PER_MINUTE": "20",
    "CORS_ORIGIN": "*",
    "CORS_ALLOWED_ORIGINS": "",
    "DEBUG_BENCHMARK_TOKEN": ""
  },
  "secrets": {
    "required": [
      "BOOTSTRAP_SIGNING_SECRET",
      "OPENAI_API_KEY"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "DeviceRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DeviceRateLimiter"
      ]
    }
  ],
  "env": {
    "staging": {
      "name": "guidepup-api-staging",
      "secrets": {
        "required": [
          "BOOTSTRAP_SIGNING_SECRET",
          "OPENAI_API_KEY"
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "class_name": "DeviceRateLimiter"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "DeviceRateLimiter"
          ]
        }
      ],
      "vars": {
        "AI_GATEWAY_BASE_URL": "",
        "AI_GATEWAY_AUTH_HEADER": "authorization",
        "AI_GATEWAY_AUTH_PREFIX": "Bearer ",
        "AI_GATEWAY_PATH": "/chat/completions",
        "AI_GATEWAY_FALLBACK_BASE_URL": "",
        "AI_GATEWAY_FALLBACK_AUTH_HEADER": "authorization",
        "AI_GATEWAY_FALLBACK_AUTH_PREFIX": "Bearer ",
        "AI_GATEWAY_FALLBACK_PATH": "/chat/completions",
        "ENVIRONMENT": "staging",
        "VISION_PROVIDER": "openai-compatible",
        "EXPERIMENTAL_MINICPM_O_BENCHMARK": "false",
        "HUGGINGFACE_MINICPM_O_BASE_URL": "",
        "HUGGINGFACE_MINICPM_O_MODEL": "openbmb/MiniCPM-o-2_6",
        "OPENAI_BASE_URL": "https://api.openai.com/v1",
        "OPENAI_MODEL": "gpt-5.5",
        "OPENAI_REASONING_EFFORT": "low",
        "PROMPT_VERSION": "2026-05-22.v1",
        "SESSION_TTL_SECONDS": "86400",
        "RATE_LIMIT_PER_MINUTE": "20",
        "CORS_ORIGIN": "",
        "CORS_ALLOWED_ORIGINS": "",
        "DEBUG_BENCHMARK_TOKEN": ""
      }
    },
    "production": {
      "name": "guidepup-api-production",
      "secrets": {
        "required": [
          "BOOTSTRAP_SIGNING_SECRET",
          "OPENAI_API_KEY"
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "class_name": "DeviceRateLimiter"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "DeviceRateLimiter"
          ]
        }
      ],
      "vars": {
        "AI_GATEWAY_BASE_URL": "",
        "AI_GATEWAY_AUTH_HEADER": "authorization",
        "AI_GATEWAY_AUTH_PREFIX": "Bearer ",
        "AI_GATEWAY_PATH": "/chat/completions",
        "AI_GATEWAY_FALLBACK_BASE_URL": "",
        "AI_GATEWAY_FALLBACK_AUTH_HEADER": "authorization",
        "AI_GATEWAY_FALLBACK_AUTH_PREFIX": "Bearer ",
        "AI_GATEWAY_FALLBACK_PATH": "/chat/completions",
        "ENVIRONMENT": "production",
        "VISION_PROVIDER": "openai-compatible",
        "EXPERIMENTAL_MINICPM_O_BENCHMARK": "false",
        "HUGGINGFACE_MINICPM_O_BASE_URL": "",
        "HUGGINGFACE_MINICPM_O_MODEL": "openbmb/MiniCPM-o-2_6",
        "OPENAI_BASE_URL": "https://api.openai.com/v1",
        "OPENAI_MODEL": "gpt-5.5",
        "OPENAI_REASONING_EFFORT": "low",
        "PROMPT_VERSION": "2026-05-22.v1",
        "SESSION_TTL_SECONDS": "86400",
        "RATE_LIMIT_PER_MINUTE": "20",
        "CORS_ORIGIN": "",
        "CORS_ALLOWED_ORIGINS": "",
        "DEBUG_BENCHMARK_TOKEN": ""
      }
    }
  }
}
