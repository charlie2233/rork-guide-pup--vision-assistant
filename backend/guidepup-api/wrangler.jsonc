{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guidepup-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    }
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "ANALYZE_IP_RATE_LIMIT_PER_MINUTE": "60",
    "AI_GATEWAY_BASE_URL": "",
    "AI_GATEWAY_AUTH_HEADER": "authorization",
    "AI_GATEWAY_AUTH_PREFIX": "Bearer ",
    "AI_GATEWAY_PATH": "/chat/completions",
    "AI_GATEWAY_FALLBACK_BASE_URL": "",
    "AI_GATEWAY_FALLBACK_AUTH_HEADER": "authorization",
    "AI_GATEWAY_FALLBACK_AUTH_PREFIX": "Bearer ",
    "AI_GATEWAY_FALLBACK_PATH": "/chat/completions",
    "BOOTSTRAP_RATE_LIMIT_PER_MINUTE": "10",
    "ENVIRONMENT": "development",
    "EXPECTED_API_URL": "",
    "VISION_PROVIDER": "openai-compatible",
    "EXPERIMENTAL_MINICPM_O_BENCHMARK": "false",
    "HUGGINGFACE_MINICPM_O_BASE_URL": "",
    "HUGGINGFACE_MINICPM_O_MODEL": "openbmb/MiniCPM-o-2_6",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_MAX_COMPLETION_TOKENS": "700",
    "OPENAI_MODEL": "gpt-5.6-sol",
    "OPENAI_REQUEST_TIMEOUT_MS": "8500",
    "OPENAI_RETRY_COUNT": "1",
    "OPENAI_RETRY_DELAY_MS": "250",
    "OPENAI_REASONING_EFFORT": "low",
    "PROVIDER_ALLOWED_ORIGINS": "https://api.openai.com",
    "PROVIDER_GLOBAL_CALL_LIMIT_PER_MINUTE": "120",
    "PROMPT_VERSION": "2026-07-18.v1",
    "RATE_LIMIT_PER_MINUTE": "20",
    "SESSION_TTL_SECONDS": "86400",
    "SOURCE_REVISION": "development",
    "CORS_ORIGIN": "*",
    "CORS_ALLOWED_ORIGINS": "",
    "DEBUG_BENCHMARK_TOKEN": "",
    "WORKER_IDENTITY": "guidepup-api"
  },
  "secrets": {
    "required": [
      "BOOTSTRAP_SIGNING_SECRET",
      "OPENAI_API_KEY"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "DeviceRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DeviceRateLimiter"
      ]
    }
  ],
  "env": {
    "staging": {
      "name": "guidepup-api-staging",
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": false,
          "persist": true
        }
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "secrets": {
        "required": [
          "BOOTSTRAP_SIGNING_SECRET",
          "OPENAI_API_KEY"
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "class_name": "DeviceRateLimiter"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "DeviceRateLimiter"
          ]
        }
      ],
      "vars": {
        "ANALYZE_IP_RATE_LIMIT_PER_MINUTE": "60",
        "AI_GATEWAY_BASE_URL": "",
        "AI_GATEWAY_AUTH_HEADER": "authorization",
        "AI_GATEWAY_AUTH_PREFIX": "Bearer ",
        "AI_GATEWAY_PATH": "/chat/completions",
        "AI_GATEWAY_FALLBACK_BASE_URL": "",
        "AI_GATEWAY_FALLBACK_AUTH_HEADER": "authorization",
        "AI_GATEWAY_FALLBACK_AUTH_PREFIX": "Bearer ",
        "AI_GATEWAY_FALLBACK_PATH": "/chat/completions",
        "BOOTSTRAP_RATE_LIMIT_PER_MINUTE": "10",
        "ENVIRONMENT": "staging",
        "EXPECTED_API_URL": "https://guidepup-api-staging.charliehan-lifepage.workers.dev",
        "VISION_PROVIDER": "openai-compatible",
        "EXPERIMENTAL_MINICPM_O_BENCHMARK": "false",
        "HUGGINGFACE_MINICPM_O_BASE_URL": "",
        "HUGGINGFACE_MINICPM_O_MODEL": "openbmb/MiniCPM-o-2_6",
        "OPENAI_BASE_URL": "https://api.openai.com/v1",
        "OPENAI_MAX_COMPLETION_TOKENS": "700",
        "OPENAI_MODEL": "gpt-5.6-sol",
        "OPENAI_REQUEST_TIMEOUT_MS": "8500",
        "OPENAI_RETRY_COUNT": "1",
        "OPENAI_RETRY_DELAY_MS": "250",
        "OPENAI_REASONING_EFFORT": "low",
        "PROVIDER_ALLOWED_ORIGINS": "https://api.openai.com",
        "PROVIDER_GLOBAL_CALL_LIMIT_PER_MINUTE": "120",
        "PROMPT_VERSION": "2026-07-18.v1",
        "RATE_LIMIT_PER_MINUTE": "20",
        "SESSION_TTL_SECONDS": "3600",
        "SOURCE_REVISION": "development",
        "CORS_ORIGIN": "",
        "CORS_ALLOWED_ORIGINS": "",
        "DEBUG_BENCHMARK_TOKEN": "",
        "WORKER_IDENTITY": "guidepup-api-staging"
      }
    },
    "production": {
      "name": "guidepup-api-production",
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": false,
          "persist": true
        }
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "secrets": {
        "required": [
          "BOOTSTRAP_SIGNING_SECRET",
          "OPENAI_API_KEY"
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "class_name": "DeviceRateLimiter"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "DeviceRateLimiter"
          ]
        }
      ],
      "vars": {
        "ANALYZE_IP_RATE_LIMIT_PER_MINUTE": "60",
        "AI_GATEWAY_BASE_URL": "",
        "AI_GATEWAY_AUTH_HEADER": "authorization",
        "AI_GATEWAY_AUTH_PREFIX": "Bearer ",
        "AI_GATEWAY_PATH": "/chat/completions",
        "AI_GATEWAY_FALLBACK_BASE_URL": "",
        "AI_GATEWAY_FALLBACK_AUTH_HEADER": "authorization",
        "AI_GATEWAY_FALLBACK_AUTH_PREFIX": "Bearer ",
        "AI_GATEWAY_FALLBACK_PATH": "/chat/completions",
        "BOOTSTRAP_RATE_LIMIT_PER_MINUTE": "10",
        "ENVIRONMENT": "production",
        "EXPECTED_API_URL": "https://guidepup-api-production.charliehan-lifepage.workers.dev",
        "VISION_PROVIDER": "openai-compatible",
        "EXPERIMENTAL_MINICPM_O_BENCHMARK": "false",
        "HUGGINGFACE_MINICPM_O_BASE_URL": "",
        "HUGGINGFACE_MINICPM_O_MODEL": "openbmb/MiniCPM-o-2_6",
        "OPENAI_BASE_URL": "https://api.openai.com/v1",
        "OPENAI_MAX_COMPLETION_TOKENS": "700",
        "OPENAI_MODEL": "gpt-5.6-sol",
        "OPENAI_REQUEST_TIMEOUT_MS": "8500",
        "OPENAI_RETRY_COUNT": "1",
        "OPENAI_RETRY_DELAY_MS": "250",
        "OPENAI_REASONING_EFFORT": "low",
        "PROVIDER_ALLOWED_ORIGINS": "https://api.openai.com",
        "PROVIDER_GLOBAL_CALL_LIMIT_PER_MINUTE": "120",
        "PROMPT_VERSION": "2026-07-18.v1",
        "RATE_LIMIT_PER_MINUTE": "20",
        "SESSION_TTL_SECONDS": "3600",
        "SOURCE_REVISION": "development",
        "CORS_ORIGIN": "",
        "CORS_ALLOWED_ORIGINS": "",
        "DEBUG_BENCHMARK_TOKEN": "",
        "WORKER_IDENTITY": "guidepup-api-production"
      }
    }
  }
}
