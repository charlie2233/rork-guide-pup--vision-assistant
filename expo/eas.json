{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_RELEASE_TRACK": "development-client",
        "EXPO_PUBLIC_ENABLE_EXPERIMENTAL_TABS": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://guidepup-api-staging.charliehan-lifepage.workers.dev",
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_RELEASE_TRACK": "internal-preview",
        "EXPO_PUBLIC_ENABLE_EXPERIMENTAL_TABS": "false",
        "EXPO_PUBLIC_WEBSITE_URL": "https://guidepup-site.pages.dev",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://guidepup-site.pages.dev/privacy",
        "EXPO_PUBLIC_SUPPORT_URL": "https://guidepup-site.pages.dev/support",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "charliehan112@gmail.com",
        "EXPO_PUBLIC_EMERGENCY_DISCLAIMER": "Guide Pup provides assistive guidance, not guaranteed hazard detection or emergency response. If the app cannot confidently analyze the scene, it stops and tells the user to pause and reorient. If you are in immediate danger, stop using the app and contact local emergency services or nearby people directly."
      }
    },
    "testflight": {
      "distribution": "store",
      "channel": "testflight",
      "autoIncrement": false,
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://guidepup-api-production.charliehan-lifepage.workers.dev",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_RELEASE_TRACK": "testflight",
        "EXPO_PUBLIC_ENABLE_EXPERIMENTAL_TABS": "false",
        "EXPO_PUBLIC_WEBSITE_URL": "https://guidepup-site.pages.dev",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://guidepup-site.pages.dev/privacy",
        "EXPO_PUBLIC_SUPPORT_URL": "https://guidepup-site.pages.dev/support",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "charliehan112@gmail.com",
        "EXPO_PUBLIC_EMERGENCY_DISCLAIMER": "Guide Pup provides assistive guidance, not guaranteed hazard detection or emergency response. If the app cannot confidently analyze the scene, it stops and tells the user to pause and reorient. If you are in immediate danger, stop using the app and contact local emergency services or nearby people directly."
      }
    },
    "store": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": false,
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://guidepup-api-production.charliehan-lifepage.workers.dev",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_RELEASE_TRACK": "app-store",
        "EXPO_PUBLIC_ENABLE_EXPERIMENTAL_TABS": "false",
        "EXPO_PUBLIC_WEBSITE_URL": "https://guidepup-site.pages.dev",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://guidepup-site.pages.dev/privacy",
        "EXPO_PUBLIC_SUPPORT_URL": "https://guidepup-site.pages.dev/support",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "charliehan112@gmail.com",
        "EXPO_PUBLIC_EMERGENCY_DISCLAIMER": "Guide Pup provides assistive guidance, not guaranteed hazard detection or emergency response. If the app cannot confidently analyze the scene, it stops and tells the user to pause and reorient. If you are in immediate danger, stop using the app and contact local emergency services or nearby people directly."
      }
    }
  },
  "submit": {
    "testflight": {
      "metadataPath": "store.config.js",
      "ios": {
        "appleTeamId": "K99RADPB9G",
        "ascAppId": "6756947790"
      }
    },
    "store": {
      "metadataPath": "store.config.js",
      "ios": {
        "appleTeamId": "K99RADPB9G",
        "ascAppId": "6756947790"
      }
    }
  }
}
