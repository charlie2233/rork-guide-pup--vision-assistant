{
  "name": "guidepup-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "start:web": "expo start --web",
    "start:tunnel": "expo start --tunnel",
    "preflight": "node scripts/release-preflight.mjs --track testflight",
    "release:preflight": "node scripts/release-preflight.mjs --track testflight",
    "release:preflight:preview": "node scripts/release-preflight.mjs --track preview",
    "release:preflight:testflight": "node scripts/release-preflight.mjs --track testflight",
    "release:preflight:store": "node scripts/release-preflight.mjs --track store",
    "release:preflight:all": "node scripts/release-preflight.mjs --track all",
    "check:voice-commands": "node scripts/check-voice-commands.mjs",
    "check:no-screen-smoke": "node scripts/check-no-screen-smoke-contract.mjs",
    "check:no-screen-evidence": "node scripts/validate-no-screen-smoke-evidence.mjs",
    "check:release-source": "node scripts/release-source-state.mjs",
    "release:candidate-evidence": "node scripts/release-candidate-evidence.mjs",
    "test:guideai-conversation-memory": "node --test scripts/guideai-conversation-memory.test.mjs",
    "test:ios-runtime-safety": "node --test scripts/ios-runtime-safety-contract.test.mjs scripts/ios-runtime-safety-behavior.test.mjs scripts/conversation-lane-behavior.test.mjs scripts/ios-device-readiness.test.mjs",
    "test:ios-device-readiness": "node --test scripts/ios-device-readiness.test.mjs",
    "test:smoke-evidence": "node --test scripts/smoke-evidence-validation.test.mjs",
    "test:no-screen-evidence": "node --test scripts/no-screen-smoke-evidence.test.mjs",
    "test:privacy-launch-contract": "node --test scripts/privacy-launch-contract.test.mjs",
    "test:release-config-hardening": "node --test scripts/release-config-hardening.test.mjs",
    "test:release-evidence": "node --test scripts/release-source-state.test.mjs scripts/release-candidate-evidence.test.mjs",
    "check:ios-device": "node scripts/check-ios-device-ready.mjs",
    "build:internal:ios": "npx eas-cli build --profile preview --platform ios",
    "build:preview:ios": "npx eas-cli build --profile preview --platform ios",
    "build:testflight:ios": "npx eas-cli build --profile testflight --platform ios",
    "submit:testflight:ios": "npx eas-cli submit --profile testflight --platform ios",
    "build:store:ios": "npx eas-cli build --profile store --platform ios",
    "submit:store:ios": "npx eas-cli submit --profile store --platform ios",
    "metadata:push:ios": "npx eas-cli metadata:push --profile store",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "sentry:upload-sourcemaps:update": "npx sentry-expo-upload-sourcemaps dist"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@nkzw/create-context-hook": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.83.0",
    "@ungap/structured-clone": "^1.3.0",
    "axios": "^1.13.2",
    "expo": "~54.0.36",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.7",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^0.548.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.3.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
