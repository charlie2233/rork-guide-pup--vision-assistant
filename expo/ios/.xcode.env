# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
#
# Customize the NODE_BINARY variable here.
# For example, to use nvm with brew, add the following line
# . "$(brew --prefix nvm)/nvm.sh" --no-use
export NODE_BINARY=$(command -v node)

# Direct Xcode builds do not receive EAS profile variables. Keep checked-in,
# public-only launch defaults here so simulator, device, and archive bundles use
# the same staging/production ownership as EAS. EAS-provided values still win.
if [ "${CONFIGURATION:-Debug}" = "Release" ]; then
  GUIDE_PUP_DEFAULT_API_BASE_URL="https://guidepup-api-production.charliehan-lifepage.workers.dev"
  GUIDE_PUP_DEFAULT_APP_ENV="production"
  GUIDE_PUP_DEFAULT_RELEASE_TRACK="app-store"
else
  GUIDE_PUP_DEFAULT_API_BASE_URL="https://guidepup-api-staging.charliehan-lifepage.workers.dev"
  GUIDE_PUP_DEFAULT_APP_ENV="preview"
  GUIDE_PUP_DEFAULT_RELEASE_TRACK="internal-preview"
fi

export EXPO_PUBLIC_API_BASE_URL="${EXPO_PUBLIC_API_BASE_URL:-$GUIDE_PUP_DEFAULT_API_BASE_URL}"
export EXPO_PUBLIC_APP_ENV="${EXPO_PUBLIC_APP_ENV:-$GUIDE_PUP_DEFAULT_APP_ENV}"
export EXPO_PUBLIC_RELEASE_TRACK="${EXPO_PUBLIC_RELEASE_TRACK:-$GUIDE_PUP_DEFAULT_RELEASE_TRACK}"
export EXPO_PUBLIC_ENABLE_EXPERIMENTAL_TABS="${EXPO_PUBLIC_ENABLE_EXPERIMENTAL_TABS:-false}"
export EXPO_PUBLIC_WEBSITE_URL="${EXPO_PUBLIC_WEBSITE_URL:-https://guidepup-site.pages.dev}"
export EXPO_PUBLIC_PRIVACY_POLICY_URL="${EXPO_PUBLIC_PRIVACY_POLICY_URL:-https://guidepup-site.pages.dev/privacy}"
export EXPO_PUBLIC_SUPPORT_URL="${EXPO_PUBLIC_SUPPORT_URL:-https://guidepup-site.pages.dev/support}"
export EXPO_PUBLIC_SUPPORT_EMAIL="${EXPO_PUBLIC_SUPPORT_EMAIL:-charliehan112@gmail.com}"
export EXPO_PUBLIC_EMERGENCY_DISCLAIMER="${EXPO_PUBLIC_EMERGENCY_DISCLAIMER:-Guide Pup provides assistive guidance, not guaranteed hazard detection or emergency response. If the app cannot confidently analyze the scene, it stops and tells the user to pause and reorient. If you are in immediate danger, stop using the app and contact local emergency services or nearby people directly.}"
unset GUIDE_PUP_DEFAULT_API_BASE_URL
unset GUIDE_PUP_DEFAULT_APP_ENV
unset GUIDE_PUP_DEFAULT_RELEASE_TRACK
